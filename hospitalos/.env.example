# ==============================================================================
# HospitalOS environment settings.
# Copy this file to .env and fill in your own values:   copy .env.example .env
# NEVER commit .env (it is in .gitignore). Only this example file is committed.
# ==============================================================================

# --- Database ---
# SQLite by default. To use PostgreSQL later, change only this line, e.g.
# DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/hospitalos"
DATABASE_URL="sqlite:///./hospitalos.db"

# --- Backend URL (used by the frontend and the CLI chat) ---
BACKEND_URL="http://127.0.0.1:8000"

# --- LLM (any OpenAI-compatible provider). Change only these 3 values to switch. ---
# Option A: Google Gemini free tier (key from https://aistudio.google.com/apikey)
LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
LLM_API_KEY="PASTE_YOUR_KEY_HERE"
LLM_MODEL="gemini-2.0-flash"

# Option B: Groq free tier (key from https://console.groq.com/keys)
# LLM_BASE_URL="https://api.groq.com/openai/v1"
# LLM_API_KEY="PASTE_YOUR_KEY_HERE"
# LLM_MODEL="llama-3.3-70b-versatile"
